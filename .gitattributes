# Normalise everything to LF in the repository.
# The project is developed on Windows and runs on Linux containers; a CRLF shebang
# fails inside the container with `exec format error`, which names neither the file
# nor the reason. Setting this before the first commit means it can never happen.
* text=auto eol=lf

# Scripts and container assets: LF, always, no exceptions.
*.sh            text eol=lf
*.bash          text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
.dockerignore   text eol=lf
entrypoint.sh   text eol=lf

# Windows-only files keep CRLF.
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Lockfiles: generated, keep them out of diffs and language stats.
package-lock.json  -diff linguist-generated
pnpm-lock.yaml     -diff linguist-generated

# Binary — never normalise, never diff.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.woff  binary
*.woff2 binary
