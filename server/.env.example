# Copy to .env for local development: cp .env.example .env
# .env is read only when NODE_ENV is not production. On Render every variable is set in the
# dashboard (or render.yaml); a .env file is ignored there. Every key is validated at boot by
# src/config/env.js — an invalid or missing one stops the process with the key name and reason.

# development | test | production
NODE_ENV=development
# HTTP port; Render injects its own
PORT=3000

# PostgreSQL connection string (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/task_management
# true on Render's managed PostgreSQL
DATABASE_SSL=false
# Maximum connections in the pool
DB_POOL_MAX=10

# Signing secret for access tokens (required). This placeholder is refused in production;
# generate a real one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=dev-only-secret-change-me-at-least-32-chars
# Access token lifetime, duration string: <n>s | m | h | d
JWT_ACCESS_TTL=15m
# Refresh token lifetime, duration string
JWT_REFRESH_TTL=7d

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma-separated allowed browser origins (credentialed CORS, so * is refused). Defaults to the
# Vite dev server outside production; required in production
CORS_ORIGINS=http://localhost:5173

# Rate limiter window in milliseconds, and requests allowed per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Milliseconds a SIGTERM drain may take before exiting 1; keep below the platform's SIGKILL grace
SHUTDOWN_TIMEOUT_MS=10000

# Commit the running build came from; set by the image build (#37), reported by /healthz. Optional
GIT_SHA=
