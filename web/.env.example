# Copy to .env for local development: cp .env.example .env
#
# VITE_* variables are inlined into the JavaScript bundle at BUILD time and are PUBLIC: anyone can
# read them in the browser. Never put a secret here. Changing one needs a rebuild, which is why the
# Render static site sets it as a build-time variable (#66).

# Base URL of the API (server/). The API's CORS_ORIGINS must list this app's origin.
VITE_API_URL=http://localhost:3000
